pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- asteroid field for pico-8
-- carlos peralta 2026

-- ============================
-- TODO / SIGUIENTES PASOS
-- ============================
-- 1. arreglar sistema de colisiones
-- 2  invulnerabilidad y timer
-- 4. contador de puntos (score)
-- 5. muerte del jugador/vidas
-- 6. sistema de bombas
-- 7. seleccion de upgrades
-- 8. ajuste del tamano del texto y
-- 			ventana en estado 2
-- ============================

--------- main game loop -------
function _init()
	cls()
	scrlim = { min=0 , max=128 }
	ast_speed_default = {1,2,3}
	ast_sprites = {2,3,4,5,6}
	star_cols = {5,5,5,6,6,7}
	flips = {true, false}
	game_state = 0 --0 ➡️ pregame, 1 ➡️ ongoing , 2 ➡️ new level
	max_score = 0
	new_rcrd = false
	set_new_game()
	game_state = 0
end

function _update()
	update_stars()
	if game_state == 0 then
		max_score = max(max_score,score)
		new_rcrd = score >= max_score and true or false
		if (btn(❎)) then
			game_state = 1
			set_new_game()
		end
	
	elseif game_state == 1 then
		p:get_move()

		for a in all(ast) do
			a:move()
			if a.y >= scrlim.max then
				del(ast, a)
				scr_upd(true)
			end
		end

		if crash_check(ast, p) then
			lives -=1
			sfx(62)
			scr_upd(false,false,true)
			if (lives < 1) game_state = 0
		else
			dodges += 1
			if (dodges % 10 == 0) bonusx += 1
		end
		get_game_state()
	
	elseif game_state == 2 then
		if (btn(❎)) game_state = 1
	end
end

function _draw()
	cls()
	draw_stars(stars)
	p:set()

	if game_state == 0 then
		rrectfill(22,60,82,7, 10,10)
		rrect(22,60,82,7, 10,9)
		print("asteroid field - ❎", 26,61,5)
		if max_score > 0 then
			rrectfill(0,70,127,10,0,0)
			if (new_rcrd == true) then
				print("😐 new record!: ".. max_score,24, 72, 10)
			else
				print("max score: ".. max_score,28, 72, 5)
			end
		end
	
	elseif game_state == 1 then
		for a in all(ast) do
			a:set()
		end
		rrectfill(1,1,40,7, 10,10)
		rrect(1,1,40,7, 10,9)
		print("●:".. score, 2,2,5)
		rrectfill(107,1,20,7, 10,10)
		rrect(107,1,20,7, 10,9)
		print("♥:"..lives, 108,2, 5)
		print("bonus:"..bonusx, 50,2, 10)
	
	elseif game_state == 2 then
		rrectfill(22,60,82,7, 10,10)
		rrect(22,60,82,7, 10,9)
		print("level: "..level.." - press ❎", 26,61,5)
	end
end

-->8
--characters
--player class
function class_player()
	-- defaults
	local ofs = 4
	-- player parameters an methods
	 return {
		ofs = ofs,
		x = scrlim.max /2 - ofs,
		y = scrlim.max /2 +20 - ofs,
		dx = 1,
		dy = 1,
		sprt = 1,
		minlim = scrlim.min,
		maxlim = scrlim.max - (ofs*2),
		-- draw character
		set = function(self)
			spr(self.sprt, self.x, self.y)
		end,
		-- move player
		get_move = function(self)
			-- get buttons input
			if (btn(⬅️)) self.x -= self.dx
			if (btn(➡️)) self.x += self.dx
			if (btn(⬆️)) self.y -= self.dy
			if (btn(⬇️)) self.y += self.dy
			-- keep player in screen
			self.x = mid(self.minlim, self.x, self.maxlim)
			self.y = mid(self.minlim, self.y, self.maxlim)
		end
	}
end

--asteroid class
function class_asteroid()
	--defaults
	local ofs = 4
	local dy = rnd(ast_speed_default)
	-- asteroid parameters and methods
	return {
		ofs = ofs,
		dy = dy,
		x = rnd(scrlim.max-ofs),
		y = scrlim.min - rnd(scrlim.max*dy),
		sprit = rnd(ast_sprites),
		xflip = rnd(flips),
		yflip = rnd(flips),
		-- draw asteroid
		set = function(self)
			spr(self.sprit, self.x, self.y, 1, 1,  self.xflip, self.yflip)
		end,
		--update position
		move = function(self)
			self.y += self.dy
		end
	}
end

-- create an enemy batch
function create_asteroids( n )
	local t_asteroids = {}
	for i = 1,n do
		add(t_asteroids, class_asteroid())
	end
	return t_asteroids
end

-- check if any enemies left and
-- update state and level difficulty
function get_game_state()
	if #ast == 0 then
		num_ast += 10
		ast=create_asteroids(num_ast)
		level += 1
		game_state = 2
	end
end

-- check for collisions
function crash_check(astlist, player)
	local pcx = player.x + player.ofs
	local pcy = player.y + player.ofs

	for a in all(astlist) do
		local acx = a.x + a.ofs
		local acy = a.y + a.ofs
		
		local dx = acx - pcx
		local dy = acy - pcy
		
		-- Bounding Box: Solo calcula Pitagoras si estan a menos de 20 pixeles de distancia.
		-- Esto evita que dx*dx supere el limite de 32767.
		if abs(dx) < 20 and abs(dy) < 20 then
			local cats_2 = (dx * dx) + (dy * dy)
			local hip_2 = ((a.ofs - 1) + (player.ofs - 1)) * ((a.ofs - 1) + (player.ofs - 1))
			
			if cats_2 < hip_2 then
				del(astlist,a)
				return true
			end
		end
	end
	return false
end

-->8
-- background
--palette
pal({[0]=129,1,2,3,4,5,6,7,8,9,135,11,12,13,0,15},1)

-- estrellas
function class_star()
	local star = {
  x = rnd(scrlim.max),
  y = rnd(scrlim.max),
  siz = 0,
  col = rnd(star_cols)
	}
	
	-- evaluamos el color para asignar la velocidad
	if star.col == 5 then
		star.spd = 0.1 + rnd(0.1) -- lejanas: muy lentas (0.1 a 0.2)
	elseif star.col == 6 then
		star.spd = 0.3 + rnd(0.2) -- intermedias: medias (0.3 a 0.5)
	elseif star.col == 7 then
		star.spd = 0.7 + rnd(0.3) -- cercanas: rapidas (0.7 a 1.0)
	end
	
	star.brite = star.col
	return star
end
-- crea tabla de estrellas
-- para que sea la misma
-- aunque se actualice o
-- se borre la pantalla
function create_stars()
	local stars = {}
	for i=1,200 do
		add(stars,class_star())
	end
	return stars
end
-- dibuja estrellas
function draw_stars(st)
	for s in all(st) do
		circfill(s.x,s.y,s.siz,s.brite)
	end
end
-- mover estrellas
function update_stars()
	for s in all(stars) do
		if rnd(1) < 0.01 then
			s.brite = rnd({
				s.col,
				s.col,
				s.col,
				s.col,
				0})
		end

	 s.y += s.spd

	 if s.y > scrlim.max then
		 s.y = scrlim.min
		 s.x = rnd(scrlim.max)
	 end
 end
end

-->8
--game logic

-- score updater
function scr_upd(ad_s, ad_m, rst)
	if rst then
		bonusx = 1
	else
		if (ad_s) score += basexpoints * bonusx
		if (ad_m) bonusx += 1
	end
end

function set_new_game()
	p = class_player()
	stars = create_stars()
	lives = 3
	score = 0
	bonusx = 1
	basexpoints = 1
	dodges = 0
	level = 0
	num_ast = 50
	ast = create_asteroids(num_ast)
end
